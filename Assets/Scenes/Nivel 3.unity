--- !u!114 &2144717073
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2144717072}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c8df075b24e3b664db40e12d1e31bf39, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  narrations:
  - audioClip: {fileID: 8300000, guid: aeea81f93ed5cfa41b86e95fa14302da, type: 3}
    text: "By now, it\u2019s well expected that the Koi will fall. It\u2019s also
      to be expected that it will rise again. "
    volume: 1
  - audioClip: {fileID: 8300000, guid: 464a72c2f571f4c4cbad456b9f4bc687, type: 3}
    text: "That looked like it hurt. But the fish doesn\u2019t care. It will not
      relent."
    volume: 1
  - audioClip: {fileID: 8300000, guid: edb80d92f2dda404a8dc379352e6d307, type: 3}
    text: It was never the most capable animal on this mountain. But it may be the
      most impressive.
    volume: 1
  delayBetweenNarrations: 9
  minAscentThreshold: 40
  minFallThreshold: 40
  cooldownDuration: 5
