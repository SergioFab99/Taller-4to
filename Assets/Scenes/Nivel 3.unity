--- !u!114 &850239074
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 850239067}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 71aebd8aa7b20aa4a8fdcf8d3799eab5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  narrations:
  - audioClip: {fileID: 8300000, guid: 2042ed8dde47f3f4f9ce0ff4555019a7, type: 3}
    text: 'One can almost sense its desperation, rushing forward, so close to the
      end. '
    volume: 1
  - audioClip: {fileID: 8300000, guid: 1fd4ce6cfa7252747b20ef3ecb21f9cc, type: 3}
    text: The fish best make haste. Especially in such harsh conditions, its oxygen
      will not last long.
    volume: 1
  - audioClip: {fileID: 8300000, guid: 31d6f70a0e39a5f4dbc768bb3cee37ab, type: 3}
    text: It would be a shame to see it die so close to the end.
    volume: 1
  delayBetweenNarrations: 9
  player: {fileID: 879080029}
  interval: 100
