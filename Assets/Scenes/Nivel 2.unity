    - target: {fileID: 8878443325836473179, guid: ec3e36107eefd2f4a8804c4f57aef027, type: 3}
      propertyPath: m_TagString
      value: Player
      objectReference: {fileID: 0}
    - target: {fileID: 8956339679047217944, guid: ec3e36107eefd2f4a8804c4f57aef027, type: 3}
      propertyPath: delay
      value: 15
      objectReference: {fileID: 0}
    - target: {fileID: 8956339679047217944, guid: ec3e36107eefd2f4a8804c4f57aef027, type: 3}
      propertyPath: 'texts.Array.data[0]'
      value: 'The Koi truly is hard headed. It must be, to survive such impacts. '
      objectReference: {fileID: 0}
    - target: {fileID: 8956339679047217944, guid: ec3e36107eefd2f4a8804c4f57aef027, type: 3}
      propertyPath: 'texts.Array.data[1]'
      value: Is it worth it? The falls, the pain? It must be.
      objectReference: {fileID: 0}
    - target: {fileID: 8956339679047217944, guid: ec3e36107eefd2f4a8804c4f57aef027, type: 3}
      propertyPath: 'texts.Array.data[2]'
      value: "For such a frail specimen, it\u2019s surprisingly tenacious."
      objectReference: {fileID: 0}
