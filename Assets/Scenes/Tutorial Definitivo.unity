  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c8df075b24e3b664db40e12d1e31bf39, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  narrations:
  - audioClip: {fileID: 8300000, guid: 542cde0a41e5dfc459de0bfd32d2499c, type: 3}
    text: "Predictably, the choking little fish stumbles and falls. The fact that
      it\u2019s even attempting this proves its stupidity. "
    volume: 1
  - audioClip: {fileID: 8300000, guid: 4ab98f2e39f430942999b72b116afcd1, type: 3}
    text: And The Koi loses any modicum of progress it may have made, obviously.
    volume: 1
  - audioClip: {fileID: 8300000, guid: 0d05e3d6dcf10ec47936dc5f177f10c0, type: 3}
    text: One has to wonder whether it realizes its pathetic body is not made for
      this challenge.
    volume: 1
  delayBetweenNarrations: 10
  minAscentThreshold: 40
  minFallThreshold: 40
  cooldownDuration: 5
