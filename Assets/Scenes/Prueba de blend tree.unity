--- !u!114 &3885286255972029593
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3645260470775469274}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 381ecd27b1c988644b12d2a802b21a52, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  texts:
  - "Predictably, the choking little fish stumbles and falls. The fact that it\u2019s
    even attempting this proves its stupidity. "
  - And The Koi loses any modicum of progress it may have made, obviously.
  - One has to wonder whether it realizes its pathetic body is not made for this
    challenge.
  delay: 10
  minAscentThreshold: 40
  minFallThreshold: 40
  cooldownDuration: 5
